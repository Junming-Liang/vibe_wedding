# 复制为 .env 后修改；切勿将含敏感配置的 .env 提交到 Git
PORT=3840
# 监听地址：默认 127.0.0.1，不对外网开放；勿随意改为 0.0.0.0
HOST=127.0.0.1
# 逗号分隔的前端来源，需与浏览器访问请柬页的 Origin 一致（须含 https 与主机名）
# 示例含线上请柬：留空则服务端内置默认列表（含 jamilblog.top 与本地 dev/preview）
CORS_ORIGINS=https://jamilblog.top,http://localhost:5173,http://127.0.0.1:5173
# SQLite：相对路径均相对 invite_messages_api 包根（与 package.json 同级），与进程 cwd 无关
DATABASE_PATH=data/messages.db
