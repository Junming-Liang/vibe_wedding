# 手工示例。推荐一键安装（自动填路径、Node、用户）：
#   cd .../invite_messages_api && sudo ./deploy/install-systemd.sh
#
# 若坚持手拷：替换路径与 User 后执行
#   sudo cp deploy/invite-messages-api.service.example /etc/systemd/system/invite-messages-api.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now invite-messages-api

[Unit]
Description=Wedding invite messages API (SQLite + Express)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/vibe_wedding/invite_messages_api
EnvironmentFile=/opt/vibe_wedding/invite_messages_api/.env
# 默认 .env 中 HOST=127.0.0.1，不对外监听；勿随意改为 0.0.0.0
ExecStart=/usr/bin/node /opt/vibe_wedding/invite_messages_api/src/server.js
Restart=on-failure
RestartSec=5
User=www
Group=www

[Install]
WantedBy=multi-user.target
